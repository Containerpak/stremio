{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
  "manifest_version": "2.0",
  "name": "Stremio",
  "description": "Freedom to stream.",
  "version": "4.4.168",
  "image": "ghcr.io/containerpak/stremio:main",
  "runtime_sources": [{"name": "stremio_4.4.168-1_amd64.deb", "url": "https://dl.strem.io/shell-linux/v4.4.168/stremio_4.4.168-1_amd64.deb", "sha256": "1028f1a38a70fc66bfcda1c8a9e1674231e17ac81774fc48859ed8f53c7a6039", "size": 984656, "installer": "deb-extract"}],
  "binaries": ["/usr/local/bin/stremio-cpak"],
